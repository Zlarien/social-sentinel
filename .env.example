# Social Sentinel Configuration
# Copy to .env and fill in your API keys

# OpenAI API (required for AI analysis & content generation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Apify API (optional - for real scraping, defaults to mock data)
APIFY_API_KEY=your-apify-key-here

# Set to "false" to use real Apify scraping instead of mock data
USE_MOCK_DATA=true
